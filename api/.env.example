# Neon: cadena "pooled" (host con -pooler) para la app, y "direct" (sin -pooler) para migraciones
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

PORT=4000
NODE_ENV=development
JWT_SECRET="cambiar-por-un-string-largo-y-aleatorio"
# Origenes permitidos para CORS, separados por coma
CORS_ORIGINS="http://localhost:5173"
# URL publica del frontend (para links de los emails)
WEB_URL="http://localhost:5173"

# Modo demo: emails en pantalla (no se envian), cuentas demo protegidas, reset nocturno
DEMO_MODE=true
# Secreto para el endpoint de reset (lo llama GitHub Actions)
CRON_SECRET="cambiar-por-otro-secreto"

# Emails reales (solo si DEMO_MODE=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brasa & Navaja <turnos@example.com>"
